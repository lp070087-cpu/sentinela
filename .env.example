# Node 24+, local development only. No production credentials.
NODE_ENV=development
PORT=4173
HOST=127.0.0.1
SENTINELA_DB=apps/web/data/sentinela.sqlite
# Real delivery adapters are optional. HTTPS endpoints must accept JSON {kind,to,subject,body,token?,code?}.
# Configure only a provider you control; do not log the authorization token.
EMAIL_DELIVERY_URL=
SMS_DELIVERY_URL=
DELIVERY_BEARER_TOKEN=
# Neon migration schema provided, not active until a PostgreSQL adapter is implemented.
DATABASE_URL=
